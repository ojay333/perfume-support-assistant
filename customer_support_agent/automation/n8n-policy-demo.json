            }
          ]
        },
        "options": {}
      },
      "id": "set-question",
      "name": "Question",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [240, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:8001/ask",
        "sendBody": true,
        "specifyBody": "json",
